  "imageAssets": {
    "note": "All artwork is inline SVG / CSS — no external raster files (.png/.jpg) are referenced.",
    "brand": [
      { "id": "logoMark", "type": "inline-svg", "desc": "Ticket-stub badge with perforation, gradient tile", "usage": "expanded logo, app bar" },
      { "id": "favicon", "type": "inline-svg", "desc": "Monogram mark at 16/32/64px + mono variant", "usage": "favicon / browser tab" },
      { "id": "appIcon", "type": "inline-svg", "desc": "Rounded-square launcher icon, dark gradient", "usage": "homescreen app icon" }
    ],
    "illustrations": [
      { "id": "error404", "type": "inline-svg", "desc": "Friendly ticket face reading 404", "usage": "not-found state" },
      { "id": "connectionLost", "type": "inline-svg", "desc": "Wi-Fi arcs with pink slash", "usage": "offline / connection error" },
      { "id": "emptyState", "type": "inline-svg", "desc": "Dashed ticket + magnifier", "usage": "no results / empty list" }
    ],
    "fallbacks": [
      { "id": "eventImageFallback", "type": "inline-svg", "desc": "Gradient + diagonal stripe pattern, ticket glyph", "aspect": "16:9" },
      { "id": "venuePhotoFallback", "type": "inline-svg", "desc": "Navy gradient skyline + map pin", "aspect": "16:9" }
    ],
    "generated": [
      { "id": "qrCode", "type": "css-matrix", "desc": "25×25 QR-style matrix with finder patterns", "usage": "booking confirmation ticket" }
    ],
    "icons": {
      "type": "inline-svg",
      "set": ["search", "map-pin", "calendar", "bell", "heart", "sun", "moon", "filter", "check", "lock", "clock", "credit-card", "camera", "user", "home", "ticket", "globe", "grid", "chevron", "logout", "alert"]
    }
