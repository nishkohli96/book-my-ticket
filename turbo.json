{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lib:build": {
      "dependsOn": ["^lib:build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^lib:build"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["^build", "^lib:build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^lib:build"],
      "outputs": ["build/**", "dist/**", ".next/**", "!.next/cache/**"]
    }
  }
}
