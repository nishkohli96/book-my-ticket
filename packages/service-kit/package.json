{
  "name": "@book-my-ticket/service-kit",
  "version": "1.0.1",
  "description": "Node-only building blocks shared by the backend services (app factory, auth middleware, logger, response helpers). Never import from apps/web.",
  "author": "Nishant Kohli",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lib:build": "tsdown",
    "lint": "eslint --fix ."
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@nish1896/eslint-flat-config": "^3.1.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.4",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "types": "./src/index.ts"
}
